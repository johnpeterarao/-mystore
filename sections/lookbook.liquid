{% capture lookbook_config %}
{
  "sectionType": "lookbook",
  "sectionId": "{{ section.id }}",
  "settings": {
    "lookbookHandle":
      {{ section.settings.lookbook | json }},
    "country":
      {{ localization.country.iso_code | json }},
    "backgroundColor":
      {{ section.settings.background_color | json }},
    "textColor":
      {{ section.settings.text_color | json }},
    "paddingTop":
      {{ section.settings.padding_top | json }},
    "paddingBottom":
      {{ section.settings.padding_bottom | json }}
  }
}
{% endcapture %}

<div
  id="lookbook-root-{{ section.id }}"
  class="lookbook-section"
  data-react-section
  data-config='{{ lookbook_config | strip_newlines | escape }}'
>
</div>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    {
      "type": "metaobject",
      "id": "lookbook",
      "label": "Select Lookbook",
      "metaobject_type": "lookbook"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}